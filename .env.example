# =============================================================
# Environment Variables — COPY THIS FILE TO .env AND FILL IN
# Local example: use DB_MODE=sqlite (no MySQL needed)
# Production: set DB_MODE=mysql and fill MySQL credentials
# =============================================================

# Database mode: 'sqlite' (local) or 'mysql' (production)
DB_MODE=sqlite

# For production only - fill from InfinityFree cPanel > MySQL Databases
# DB_HOST=sql212.infinityfree.com
# DB_PORT=3306
# DB_NAME=if0_XXXXXXX_construction
# DB_USER=if0_XXXXXXX
# DB_PASS=your_strong_password_here

# SECURITY: never commit real .env, never upload database_mysql.sql
# On InfinityFree, upload .env once via FileZilla, then verify
# https://yourdomain.rf.gd/.env returns 403
