# =============================================================
# Environment Variables — COPY THIS FILE TO .env AND FILL IN
# =============================================================

# Database mode: 'sqlite' (local) or 'mysql' (production)
DB_MODE=mysql

# MySQL credentials (from your Neon.tech free database)
DB_HOST=your-db-host.neon.tech
DB_PORT=5432
DB_NAME=construction_manager
DB_USER=your-db-username
DB_PASS=your-db-password
