# =============================================================
# ConstructionManager .gitignore - SECURED
# =============================================================

# Database files (local development only)
 /data/*.db
 /data/*.db-journal
 /data/*.db-shm
 /data/*.db-wal
 /data/*.log
 /data/php_errors.log

# Environment & secrets - NEVER commit
.env
.env.local
.env.production.bak
.env.*.bak
config.local.php
*.local.php
config.php.bak*
*.bak
*.bak_singleton

# Logs - never upload
*.log
debug.log
report.txt
*.sql
database_mysql.sql
database.sql

# Backup & OS files
.DS_Store
Thumbs.db
desktop.ini
*~

# IDE files
.vscode/
.idea/
*.swp
*.swo

# WAMP/XAMPP specific
wampmanager.conf
wamp.ini

# Temporary files
*.tmp
*.bak
*.backup
*.old
*.orig
*.save
*.temp

# Build artifacts
/dist/
/build/

# InfinityFree: do not upload local data folder content (except .htaccess)
data/
!data/.htaccess
